# Copy to .env.local and fill in. Never commit .env.local.
# Keep this file in sync with .env.local whenever a variable is added, removed
# or its meaning changes — structure and comments here, real values only there.

# --- Supabase ---------------------------------------------------------------
# Shared with biggerfish, finalbid AND wheatbid. The free tier allows two
# projects and calorie-tracker + biggerfish took both slots, so this game lives
# in a `magiczny_miecz` SCHEMA inside biggerfish's project (ref
# aqqdamoqwxiquhkzzcix). Same URL and same service-role key as the other three
# — the schema is what keeps the rows apart. See db/schema.sql.
#
# The schema must be listed under Settings -> API -> Exposed schemas, together
# with its tables, or every query fails with PGRST106.
#
# Server-only. RLS is enabled with zero policies, so this key is the only way
# in — and it grants all four tenants' tables, including two that take real
# payments. Treat a leak here as a leak of all of them.
SUPABASE_URL=https://aqqdamoqwxiquhkzzcix.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The anon key, safe to ship to the browser. Used ONLY to subscribe to Realtime
# changes on this game's tables — never to read or write game state, because
# every player's hand is secret from every other player and RLS has no policies
# to enforce that. All reads and writes go through route handlers.
NEXT_PUBLIC_SUPABASE_URL=https://aqqdamoqwxiquhkzzcix.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Dev switches -----------------------------------------------------------
# Makes every die roll return this value instead of rolling, so a scripted
# table state can be reproduced by hand. Unset to roll normally.
# FORCE_ROLL=6
