next-env.d.ts

# Source scans of the physical game — 689 MB of PDFs, mirrored from Drive:
# https://drive.google.com/drive/folders/1M1_kgUjBcVSWh6MYAnU3tDmNCocBCapV
# The transcribed data in src/data/ IS committed; the scans it came from are
# not. See docs/ASSETS.md.
assets/raw/

# Derived from assets/raw by scripts/extract-assets.mjs — 119 MB of native-res
# page and card images. Regenerate with `node scripts/extract-assets.mjs`.
# The transcriptions in src/data/ and the web-sized images in public/ are what
# get committed.
assets/extracted/

# public/cards IS committed: generated by scripts/export-card-images.mjs
# from assets/extracted, which is not in the repo. Without them a fresh
# checkout still plays — the card text is always there — but shows no scans.

# The Might and Magic VI soundtrack, copied out of a GOG install. Not ours to
# redistribute and not needed to run anything — scripts/export-music.mjs derives
# the small AAC loops in public/music from it, and those ARE committed, on the
# same reasoning as public/cards. Track list and zone assignments live in
# src/data/music.json.
assets/music/

# Python bytecode from the asset scripts.
__pycache__/
*.pyc
